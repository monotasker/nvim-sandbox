# Copy to .env and adjust. Used by docker compose (standalone).
# Do not commit real secrets.

# Image / build
NVIM_SANDBOX_IMAGE=nvim-sandbox:latest
NVIM_SANDBOX_HOME_VOLUME=nvim-sandbox-home
NVIM_VERSION=v0.12.5

# Seed behaviour
EDITOR_CONFIG_PULL=0
EDITOR_TOOLS_UPDATE=0

# Optional: override default manifest path inside the container
# EDITOR_MANIFEST=/home/dev/.config/nvim-sandbox/manifest.json

# Optional personal addon (cloned onto the home volume; runs as uid 1000 only)
# EDITOR_ADDON_REPO=git@github.com:you/your-editor-addon.git
# EDITOR_ADDON_DIR=/home/dev/.local/share/nvim-sandbox/addon
# EDITOR_ADDON_SCRIPT=seed-addon.sh
# EDITOR_ADDON_REF=

# Optional LM Studio / OpenAI-compatible endpoint on the host
LMS_HOST=host.docker.internal
LMS_PORT=1234
